<form>
    <div class="topBarButtons">
        <a href="/Attendance/" class="button"><span class="icon-cancel"></span>{{t("CommonBase.cancel")}}</a>
        <button class=("button action-":type)><span class="icon-save"></span>{{t("CommonBase.save")}}</button>
    </div>
    <div class="grid page-Attendance page-Attendance-edit">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("Attendance.Attendance.Attendance")}}</h1>
            </header>
          <label>
            <span>{{t("Attendance.Attendance.worker_id")}}</span>
            <input type="number" step="1" name="worker_id" required />
        </label><label>
            <span>{{t("Attendance.Attendance.startUser_id")}}</span>
            <select data-foreign-key="user" name="startUser_id"  > </select>
        </label><label>
            <span>{{t("Attendance.Attendance.endUser_id")}}</span>
            <select data-foreign-key="user" name="endUser_id"  > </select>
        </label><label>
            <span>{{t("Attendance.Attendance.startAdded")}}</span>
            <input type="datetime-local" step="any" name="startAdded"  />
        </label><label>
            <span>{{t("Attendance.Attendance.startWorker")}}</span>
            <input type="datetime-local" step="any" name="startWorker"  />
        </label><label>
            <span>{{t("Attendance.Attendance.startSupervisor")}}</span>
            <input type="datetime-local" step="any" name="startSupervisor"  />
        </label><label>
            <span>{{t("Attendance.Attendance.endAdded")}}</span>
            <input type="datetime-local" step="any" name="endAdded"  />
        </label><label>
            <span>{{t("Attendance.Attendance.endWorker")}}</span>
            <input type="datetime-local" step="any" name="endWorker"  />
        </label><label>
            <span>{{t("Attendance.Attendance.endSupervisor")}}</span>
            <input type="datetime-local" step="any" name="endSupervisor"  />
        </label>
        </section>
    </div>
</form>