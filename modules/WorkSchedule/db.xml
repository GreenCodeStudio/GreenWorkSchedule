<?xml version="1.0" encoding="UTF-8" ?>
<root>
    <table>
        <name>work_schedule_item</name>
        <column>
            <name>id</name>
            <type>int(11)</type>
            <autoincrement>YES</autoincrement>
        </column>
        <column>
            <name>user_id</name>
            <type>int(11)</type>
        </column>
        <column>
            <name>start</name>
            <type>datetime</type>
        </column>
        <column>
            <name>end</name>
            <type>datetime</type>
        </column>
        <index>
            <type>PRIMARY</type>
            <element>id</element>
        </index>
        <index>
            <type>INDEX</type>
            <element>user_id</element>
        </index>
        <index>
            <type>INDEX</type>
            <element>work_schedule_id</element>
        </index>
        <index>
            <type>FOREIGN</type>
            <element>user_id</element>
            <reference name="user">
                <element>id</element>
            </reference>
        </index>
    </table>
    <table>
        <name>ical_token</name>
        <column>
            <name>id</name>
            <type>int(11)</type>
            <autoincrement>YES</autoincrement>
        </column>
        <column>
            <name>owner_user_id</name>
            <type>int(11)</type>
        </column>
        <column>
            <name>token</name>
            <type>varchar(255)</type>
        </column>
        <column>
            <name>target_user_id</name>
            <type>int(11)</type>
            <null>YES</null>
        </column>
        <index>
            <type>PRIMARY</type>
            <element>id</element>
        </index>
    </table>
</root>
