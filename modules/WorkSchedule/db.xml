<?xml version="1.0" encoding="UTF-8" ?>
<root>
    <table>
        <name>work_schedule</name>
        <column>
            <name>id</name>
            <type>int(11)</type>
            <primaryKey>true</primaryKey>
            <autoIncrement>true</autoIncrement>
        </column>
        <column>
            <name>name</name>
            <type>text</type>
        </column>
        <index>
            <type>PRIMARY</type>
            <column>id</column>
        </index>
    </table>
    <table>
        <name>work_schedule_item</name>
        <column>
            <name>id</name>
            <type>int(11)</type>
            <primaryKey>true</primaryKey>
            <autoIncrement>true</autoIncrement>
        </column>
        <column>
            <name>user_id</name>
            <type>int(11)</type>
        </column>
        <column>
            <name>work_schedule_id</name>
            <type>int(11)</type>
            <null>YES</null>
        </column>
        <column>
            <name>start</name>
            <type>datetime</type>
        </column>
        <column>
            <name>end</name>
            <type>datetime</type>
        </column>
        <index>
            <type>PRIMARY</type>
            <column>id</column>
        </index>
        <index>
            <type>INDEX</type>
            <column>user_id</column>
        </index>
        <index>
            <type>INDEX</type>
            <column>work_schedule_id</column>
        </index>
        <index>
            <type>FOREIGN</type>
            <element>user_id</element>
            <reference name="user">
                <element>id</element>
            </reference>
        </index>
        <index>
            <type>FOREIGN</type>
            <element>work_schedule_id</element>
            <reference name="work_schedule">
                <element>id</element>
            </reference>
        </index>
    </table>
</root>
