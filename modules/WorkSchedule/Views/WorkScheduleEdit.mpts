<form>
    <div class="topBarButtons">
        <a href="/WorkSchedule/" class="button"><span class="icon-cancel"></span>{{t("CommonBase.cancel")}}</a>
        <button class=("button action-":type)><span class="icon-save"></span>{{t("CommonBase.save")}}</button>
    </div>
    <div class="grid page-WorkSchedule page-WorkSchedule-edit">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("WorkSchedule.WorkSchedule.WorkSchedule")}}</h1>
            </header>
          <label>
            <span>{{t("WorkSchedule.WorkSchedule.name")}}</span>
            <input type="text" name="name" required />
        </label>
        </section>
    </div>
</form>