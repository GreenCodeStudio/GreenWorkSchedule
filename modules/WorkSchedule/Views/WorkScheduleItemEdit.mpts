<form>
    <div class="topBarButtons">
        <a href="/WorkScheduleItem/" class="button"><span class="icon-cancel"></span>{{t("CommonBase.cancel")}}</a>
        <button class=("button action-":type)><span class="icon-save"></span>{{t("CommonBase.save")}}</button>
    </div>
    <div class="grid page-WorkScheduleItem page-WorkScheduleItem-edit">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("WorkSchedule.WorkScheduleItem.WorkScheduleItem")}}</h1>
            </header>
          <label>
            <span>{{t("WorkSchedule.WorkScheduleItem.user")}}</span>
            <select data-foreign-key="user" name="user_id" required > </select>
        </label>
<!--        <label>-->
<!--            <span>{{t("WorkSchedule.WorkScheduleItem.work_schedule_id")}}</span>-->
<!--            <select data-foreign-key="work_schedule" name="work_schedule_id"  > </select>-->
<!--        </label>-->
        <label>
            <span>{{t("WorkSchedule.WorkScheduleItem.date")}}</span>
            <input type="date" step="any" name="date" required />
        </label>
        <label>
            <span>{{t("WorkSchedule.WorkScheduleItem.start")}}</span>
            <input type="time" step="any" name="start" required />
        </label>
        <label>
            <span>{{t("WorkSchedule.WorkScheduleItem.end")}}</span>
            <input type="time" step="any" name="end" required />
        </label>
        </section>
    </div>
</form>
