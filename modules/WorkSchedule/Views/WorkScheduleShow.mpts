<form>
    <div class="topBarButtons">
        <a href=("/WorkSchedule/edit/":item.id) class="button action-edit"><span class="icon-edit"></span>{{t("CommonBase.edit")}}</a>
    </div>
    <div class="grid page-WorkSchedule page-WorkSchedule-show">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("WorkSchedule.WorkSchedule.WorkSchedule")}}</h1>
            </header>
          <div class="pseudoLabel">
            <span>{{t("WorkSchedule.WorkSchedule.name")}}:</span>
            <strong>{{item.name}}</strong>
        </div>
        </section>
    </div>
</form>